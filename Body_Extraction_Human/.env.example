# Copy to .env or run scripts/bootstrap.py. Never commit .env or .runtime/.
DATABASE_URL=postgresql://body_app:CHANGE_ME@127.0.0.1:55438/body_extraction
BODY_PG_PASSWORD=CHANGE_ME
BODY_USERNAME=admin
BODY_PASSWORD=CHANGE_ME_TO_A_LONG_PASSWORD
BODY_SECRET=CHANGE_ME_TO_A_RANDOM_32_BYTE_SECRET
BODY_COOKIE_SECURE=false
BODY_PARSER=sapiens2_1b
BODY_DEVICE=cuda:0
BODY_MAX_UPLOAD_MB=500
BODY_MAX_VIDEO_SECONDS=3600
BODY_MAX_SAMPLED_FRAMES=3600
BODY_MIN_FREE_DISK_GIB=20
